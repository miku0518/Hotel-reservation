<H2>施設詳細ページ<h2>

<h1><%= @room.hotelname %></h1>
<p><%= @room.hotelintoroduction %></p>
<p>料金: <%= @room.price %>円 / 日</p>

<% if @room.image.attached? %>
  <%= image_tag @room.image %>
<% else %>
  <%= image_tag "default_room.png" %>
<% end %>

<div>
  <%= link_to "予約する", new_room_reservation_path(@room), class: "btn btn-primary" %>
  <%= link_to "戻る", :back %>
</div>