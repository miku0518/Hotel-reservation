<h2>施設一覧</h2>

<ul>
  <% @rooms.each do |room| %>
   <% if room.image.attached? %>
     <%= image_tag room.image %>
   <% else %>
     <%= image_tag "default_room.png" %>
  <% end %>

  <%= link_to room.hotelname, room_path(room) %>  
    <p><%= room.hotelintoroduction %></p>
    <p>宿泊料金：<%= room.price %>円 / 日</p>
    <p>作成日：<%= room.created_at.strftime("%Y/%m/%d") %></p>
  </li>
  <% end %>
</ul>
