<h1>プロフィール</h1>

<%= form_with model: @user, url: update_profile_user_path, local: true, html: { multipart: true } do |f| %>
  <% if @user.errors.any? %>
    <div class="errors">
      <h2>エラーがあります:</h2>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :icon, "アイコン画像" %><br>
    <% if current_user.icon.attached? %>
      <%= image_tag current_user.icon, width: 100, height: 100 %><br>
    <% else %>
      <%= image_tag "default_icon.png", width: 100, height: 100 %><br>
    <% end %>
    <%= f.file_field :icon %>
  </div>

  <div>
    <%= f.label :name, "名前" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div>
    <%= f.label :introduction, "自己紹介" %>
    <%= f.text_area :introduction %>
  </div>

  <div>
    <%= f.submit "保存" %>
  </div>
<% end %>

<%= link_to "キャンセル", user_account_path %>
