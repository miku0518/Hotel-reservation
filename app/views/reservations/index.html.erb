<h1>予約一覧</h1>

<ul>
  <% @reservations.each do |reservation| %>
    <li>
      <% room = reservation.room %>

      <% if room.image.attached? %>
        <%= image_tag room.image %>
      <% else %>
        <%= image_tag "default_room.png" %>
      <% end %>

      <p>施設名: <%= link_to room.hotelname, room_path(room) %></p>
      <p>紹介文: <%= room.hotelintoroduction %></p>
      <p>合計料金: <%= reservation.total_price %> 円</p>
      <p>チェックイン日: <%= reservation.checkin.strftime("%Y/%m/%d") %></p>
      <p>チェックアウト日: <%= reservation.checkout.strftime("%Y/%m/%d") %></p>
      <p>予約確定日時: <%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>
    </li>
  <% end %>
</ul>
